<Window x:Class="VulcansReplayStudio2.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vulcans Replay Studio 2.0" Height="900" Width="1400"
        Background="{StaticResource BgBrush}"
        WindowStartupLocation="CenterScreen"
        MinHeight="700" MinWidth="1100">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        
        <Border Grid.Column="0" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="80"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="60"/>
                </Grid.RowDefinitions>
                
                <Border Grid.Row="0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                    <StackPanel VerticalAlignment="Center" Margin="16,0">
                        <TextBlock Text="VULCANS" Foreground="{StaticResource NeonGreenBrush}" FontSize="20" FontWeight="Bold" FontFamily="Segoe UI"/>
                        <TextBlock Text="REPLAY STUDIO 2.0" Foreground="{StaticResource TextSecondaryBrush}" FontSize="9" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
                
                <StackPanel Grid.Row="1" Margin="0,16,0,0">
                    <Button x:Name="NavDashboard" Content="Dashboard" Style="{StaticResource NavButtonStyle}" Click="NavDashboard_Click"/>
                    <Button x:Name="NavLibrary" Content="Replay Library" Style="{StaticResource NavButtonStyle}" Click="NavLibrary_Click"/>
                    <Button x:Name="NavCapture" Content="Capture" Style="{StaticResource NavButtonStyle}" Click="NavCapture_Click"/>
                    <Button x:Name="NavSettings" Content="Settings" Style="{StaticResource NavButtonStyle}" Click="NavSettings_Click"/>
                </StackPanel>
                
                <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                    <StackPanel VerticalAlignment="Center" Margin="16,0">
                        <TextBlock Text="Status:" Foreground="{StaticResource TextMutedBrush}" FontSize="10"/>
                        <TextBlock x:Name="StatusText" Text="Ready" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
        
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="70"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <Border Grid.Row="0" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                <Grid Margin="24,0">
                    <TextBlock x:Name="PageTitle" Text="Dashboard" Foreground="{StaticResource TextBrush}" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="F9: Save Replay" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                        <TextBlock x:Name="HotkeyStatus" Text="Unregistered" Foreground="{StaticResource WarningBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>
            
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Background="{StaticResource BgBrush}">
                <Grid x:Name="ContentArea" Margin="16"/>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>