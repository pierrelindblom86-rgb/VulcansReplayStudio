<UserControl x:Class="VulcansReplayStudio2.App.Views.CaptureView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource CardStyle}" Margin="8">
        <StackPanel>
            <TextBlock Text="CAPTURE SETTINGS" Foreground="{StaticResource TextBrush}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
            <TextBlock x:Name="CaptureStatusText" Text="Idle" Foreground="{StaticResource TextBrush}" FontSize="20" FontWeight="Bold" Margin="0,4"/>
            <TextBlock Text="Display Source: Primary" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4"/>
            <TextBlock Text="Resolution: 1920x1080 @ 60fps" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4"/>
            <TextBlock Text="Replay Duration: 60s" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4"/>
            <TextBlock Text="Audio: System Audio Enabled" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4"/>
            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                <Button Content="Start Capture" Click="OnStartCapture"/>
                <Button Content="Stop Capture" Click="OnStopCapture"/>
                <Button Content="Save Replay" Click="OnSaveReplay"/>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>