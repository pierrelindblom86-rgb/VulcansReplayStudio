<Window x:Class="VulcansReplayStudio2.App.Views.ClipPlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Clip Player" Width="960" Height="600" MinWidth="640" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        KeyDown="OnWindowKeyDown" Closing="OnWindowClosing">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Video -->
        <Border Grid.Row="0" Background="Black" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <MediaElement x:Name="Player" LoadedBehavior="Manual" UnloadedBehavior="Manual" Stretch="Uniform"
                          MediaOpened="OnMediaOpened" MediaFailed="OnMediaFailed" MediaEnded="OnMediaEnded"/>
        </Border>

        <!-- Timeline -->
        <Grid Grid.Row="1" Margin="0,8,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="CurrentTimeText" Grid.Column="0" Text="00:00.000" Foreground="{StaticResource CyanBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <Slider x:Name="Timeline" Grid.Column="1" Minimum="0" Maximum="1" IsEnabled="False"
                    ValueChanged="OnTimelineValueChanged" VerticalAlignment="Center"/>
            <TextBlock x:Name="DurationText" Grid.Column="2" Text="/ 00:00.000" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="10,0,0,0"/>
        </Grid>

        <!-- Transport and volume -->
        <Grid Grid.Row="2" Margin="0,4,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="PlayPauseButton" Grid.Column="0" Content="Play" Width="80" Margin="0,0,8,0" Click="OnPlayPauseClick"/>
            <Button Grid.Column="1" Content="-5 s" Width="60" Margin="0,0,8,0" Click="OnSeekBackClick"/>
            <Button Grid.Column="2" Content="+5 s" Width="60" Margin="0,0,8,0" Click="OnSeekForwardClick"/>
            <Button x:Name="MuteButton" Grid.Column="3" Content="Mute" Width="70" Margin="0,0,8,0" Click="OnMuteClick"/>
            <Slider x:Name="VolumeSlider" Grid.Column="5" Width="140" Minimum="0" Maximum="1" Value="0.8"
                    VerticalAlignment="Center" ValueChanged="OnVolumeChanged" Margin="0,0,8,0"/>
            <Button Grid.Column="6" Content="Fullscreen" Width="90" Margin="0,0,8,0" Click="OnFullscreenClick"/>
            <Button Grid.Column="7" Content="Close" Width="100" IsCancel="True" Click="OnCloseClick"/>
        </Grid>

        <!-- Status -->
        <TextBlock x:Name="StatusText" Grid.Row="3" Margin="0,8,0,0" TextWrapping="Wrap"
                   Foreground="{StaticResource TextSecondaryBrush}" Text=""/>
    </Grid>
</Window>
