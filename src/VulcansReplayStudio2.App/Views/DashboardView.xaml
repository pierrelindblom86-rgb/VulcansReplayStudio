<UserControl x:Class="VulcansReplayStudio2.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="CAPTURE STATUS" Foreground="{StaticResource TextMutedBrush}" FontSize="10" FontWeight="SemiBold"/>
                    <TextBlock x:Name="CaptureStatusText" Text="Idle" Foreground="{StaticResource TextBrush}" FontSize="28" FontWeight="Bold" Margin="0,8,0,4"/>
                    <TextBlock Text="Not capturing" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                </StackPanel>
            </Border>
            
            <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="REPLAY BUFFER" Foreground="{StaticResource TextMutedBrush}" FontSize="10" FontWeight="SemiBold"/>
                    <TextBlock x:Name="BufferText" Text="60s" Foreground="{StaticResource NeonGreenBrush}" FontSize="28" FontWeight="Bold" Margin="0,8,0,4"/>
                    <TextBlock Text="Configured: 60 seconds" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                </StackPanel>
            </Border>
            
            <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="HOTKEY" Foreground="{StaticResource TextMutedBrush}" FontSize="10" FontWeight="SemiBold"/>
                    <TextBlock x:Name="HotkeyText" Text="F9" Foreground="{StaticResource CyanBrush}" FontSize="28" FontWeight="Bold" Margin="0,8,0,4"/>
                    <TextBlock Text="Save Replay" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                </StackPanel>
            </Border>
        </Grid>
        
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="8,16,8,8">
            <StackPanel>
                <TextBlock Text="QUICK ACTIONS" Foreground="{StaticResource TextBrush}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="BtnStartCapture" Content="Start Capture" Click="OnStartCapture"/>
                    <Button x:Name="BtnStopCapture" Content="Stop Capture" Click="OnStopCapture"/>
                    <Button x:Name="BtnSaveReplay" Content="Save Replay (F9)" Click="OnSaveReplay"/>
                    <Button x:Name="BtnOpenLibrary" Content="Open Library" Click="OnOpenLibrary"/>
                </StackPanel>
            </StackPanel>
        </Border>
        
        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Margin="8,8,8,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,12">
                    <Button x:Name="BtnClearRecent" DockPanel.Dock="Right" Content="Clear Recent Clips" Click="OnClearRecentClips" Margin="0"/>
                    <TextBlock Text="RECENT CLIPS" Foreground="{StaticResource TextBrush}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </DockPanel>
                <TextBlock x:Name="RecentClipsText" Text="No clips yet" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>