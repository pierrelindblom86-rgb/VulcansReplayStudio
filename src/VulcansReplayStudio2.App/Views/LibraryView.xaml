<UserControl x:Class="VulcansReplayStudio2.App.Views.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="http://schemas.microsoft.com/wpf/2008/toolkit">
    <Border Style="{StaticResource CardStyle}" Margin="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,12">
                <Button Content="Import Videos" Click="OnImportVideos" Margin="0,0,8,0"/>
                <Button Content="Refresh" Click="OnRefresh" Margin="0,0,8,0"/>
                <Button Content="Open Folder" Click="OnOpenFolder"/>
            </StackPanel>
            <DataGrid x:Name="ClipList" Grid.Row="1" Background="{StaticResource Bg2Brush}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Name" Width="260" Binding="{Binding Name}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                <Setter Property="ToolTip" Value="{Binding Name}"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Duration" Width="80" Binding="{Binding Duration}"/>
                    <DataGridTextColumn Header="Size" Width="100" Binding="{Binding Size}"/>
                    <DataGridTextColumn Header="Date" Width="120" Binding="{Binding Date}"/>
                    <DataGridTemplateColumn Header="Actions" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Play" Click="OnPlayClick" Margin="2"/>
                                    <Button Content="Edit" Click="OnEditClick" Margin="2"/>
                                    <Button Content="Rename" Click="OnRenameClick" Margin="2"/>
                                    <Button Content="Delete" Click="OnDeleteClick" Margin="2"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Border>
</UserControl>
