<UserControl x:Class="VulcansReplayStudio2.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource CardStyle}" Margin="8">
        <StackPanel>
            <TextBlock Text="SETTINGS" Foreground="{StaticResource TextBrush}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
            <TextBlock Text="Replay Duration (seconds):" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4"/>
            <TextBox x:Name="ReplayDurationBox" Text="60" Width="120" Margin="0,0,16,0"/>
            <TextBlock Text="Hotkey:" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4"/>
            <TextBox x:Name="HotkeyBox" Text="F9" Width="120" Margin="0,0,16,0"/>
            <TextBlock Text="Storage Path:" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4"/>
            <StackPanel Orientation="Horizontal">
                <TextBox x:Name="StorageBox" Width="300" VerticalAlignment="Center"/>
                <Button Content="Browse" Click="OnBrowseStorage" Margin="8,0,0,0"/>
            </StackPanel>
            <TextBlock Text="Default Clip Folder (new clips are saved here; blank = Storage Path):" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4"/>
            <StackPanel Orientation="Horizontal">
                <TextBox x:Name="DefaultClipFolderBox" Width="300" VerticalAlignment="Center"/>
                <Button Content="Browse" Click="OnBrowseDefaultClipFolder" Margin="8,0,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                <Button Content="Save" Click="OnSave" Width="100"/>
                <Button Content="Cancel" Click="OnCancel" Width="100"/>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>